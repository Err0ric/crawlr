# Copy to .env and load it with: uvicorn main:app --reload --env-file .env
# Every variable is optional. Non-AI modules run without any keys.
# Values shown are the code defaults.

# Free AI tier ("house key"): a Google AI Studio key. Empty means no free tier.
GEMINI_API_KEY=

# House key tuning
HOUSE_KEY_ENABLED=true
HOUSE_MODEL=gemini-2.5-flash
HOUSE_QUOTA_ANALYSIS=5
HOUSE_QUOTA_DEEPDIVE=1
HOUSE_QUOTA_GLOBAL=300
GEMINI_THINKING_BUDGET=1024

# AI response cache
AI_CACHE_TTL=86400
AI_CACHE_MAX=500

# Subprocess tools (sherlock, maigret, holehe)
MAX_CONCURRENT_TOOLS=4
TOOL_QUEUE_TIMEOUT=60

LOG_LEVEL=INFO
