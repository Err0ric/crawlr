# Copy to .env and load it with: uvicorn main:app --reload --env-file .env
# Every variable is optional. Non-AI modules run without any keys.
# Values shown are the code defaults.

# Free AI tier ("house key"): a Google AI Studio key. Empty means no free tier.
GEMINI_API_KEY=

# House key tuning
HOUSE_KEY_ENABLED=true
HOUSE_MODEL=gemini-2.5-flash
HOUSE_QUOTA_ANALYSIS=5
HOUSE_QUOTA_DEEPDIVE=1
HOUSE_QUOTA_GLOBAL=300
GEMINI_THINKING_BUDGET=1024

# Claude model used when a visitor brings their own Anthropic key
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=medium

# AI response cache
AI_CACHE_TTL=86400
AI_CACHE_MAX=500

# Subprocess tools (sherlock, maigret, holehe)
MAX_CONCURRENT_TOOLS=4
TOOL_QUEUE_TIMEOUT=60

# GitHub profile lookups. Without a token the API allows 60 requests an hour per IP.
# A fine-grained token with no scopes is enough (it only reads public profiles) and
# raises that to 5,000. Empty means anonymous.
GITHUB_TOKEN=
GITHUB_CACHE_TTL=3600

# How many proxies sit in front of the app. The client IP used for rate limits and the
# free AI quota is read that many entries from the right of X-Forwarded-For.
# Railway's edge is one. Use 0 when the app is exposed directly with no proxy.
TRUSTED_PROXY_HOPS=1

# Largest accepted request body, in bytes
MAX_BODY_BYTES=2097152

# Used for the canonical URL, Open Graph tags, robots.txt and sitemap.xml
SITE_URL=https://crawlr.lol

LOG_LEVEL=INFO
