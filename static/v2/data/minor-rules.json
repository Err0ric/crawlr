{
 "version": 1,
 "about": "The one copy of the minor guard's rules. core/minor_rules.py and static/v2/js/minorscan.js load this file and hold no pattern or threshold of their own. English only.",
 "regex_subset": "Patterns are applied to text both engines normalise the same way first (see normalize): ASCII only, lowercase unless a context says cased, one space for any whitespace, | for a line break or a bullet. Allowed: literals (U+0002 is the birth marker the birthday cake is normalised to), character classes written out ([0-9], [a-z]), groups, alternation, greedy and lazy quantifiers, lookahead, lookbehind of one fixed width, \\b, ^ and $. Not allowed: \\d \\w \\s, named groups, inline flags, Unicode classes, backreferences, possessive quantifiers, literal braces. No flags: Python compiles with re.ASCII, JavaScript with only g. {{NAME}} is replaced from macros before compiling.",
 "flags": "",
 "adult_age": 18,
 "normalize": {
  "whitespace": [
   [
    9,
    13
   ],
   [
    32,
    32
   ],
   [
    133,
    133
   ],
   [
    160,
    160
   ],
   [
    5760,
    5760
   ],
   [
    8192,
    8202
   ],
   [
    8232,
    8233
   ],
   [
    8239,
    8239
   ],
   [
    8287,
    8287
   ],
   [
    12288,
    12288
   ]
  ],
  "line_break": [
   10,
   11,
   12,
   13,
   133,
   8232,
   8233
  ],
  "drop": [
   8203,
   8204,
   8205,
   8288,
   65279,
   65038,
   65039
  ],
  "map": {
   "\u2019": "'",
   "\u2018": "'",
   "\u02bc": "'",
   "`": "'",
   "\u201c": "\"",
   "\u201d": "\"",
   "\u2013": "-",
   "\u2014": "-",
   "\u2015": "-",
   "\u2010": "-",
   "\u2011": "-",
   "\u2212": "-",
   "\u2022": "|",
   "\u00b7": "|",
   "\u2219": "|",
   "\uff5c": "|",
   "\u00a6": "|",
   "\u2502": "|",
   "\ud83c\udf82": "\u0002"
  },
  "separator_ranges": [
   [
    8192,
    11263
   ],
   [
    12288,
    12351
   ],
   [
    126976,
    129791
   ],
   [
    917504,
    917631
   ]
  ],
  "separator": "|",
  "other": "\u007f",
  "max_chars": 4000,
  "nfkc": true,
  "note": "Text is folded with Unicode NFKC first (fancy digits and letters become plain ones). The birthday cake maps to the control character U+0002, which patterns use as a birth marker; no other input can produce it."
 },
 "clause": {
  "delimiters": "|;!?",
  "period_needs_word": 2
 },
 "snippet_max": 60,
 "signals_max": 40,
 "macros": {
  "AGE": "(1[0-7]|[89])",
  "TEEN": "(1[0-7])",
  "ITEM_L": "(?:^|[|,~] ?| [/-] )",
  "ITEM_R": "(?= ?[|,~]| [/-] |$)",
  "SEP_AFTER": "(?: ?[|,~]| [/-] )",
  "ORD": "(?:1[0-2]|[1-9])(?:st|nd|rd|th)",
  "ORDWORD": "(?:first|second|third|fourth|fifth|sixth|seventh|eighth|ninth|tenth|eleventh|twelfth)",
  "HS": "(?:high ?school|hs)",
  "NOTAGE": "(?![0-9])(?!%)(?![%'\\\":.,/-][0-9])(?! ?(?:st|nd|rd|th|k|x|m|am|pm|ft|feet|foot|cm|kg|lb|lbs|min|mins|minute|minutes|hour|hours|hr|hrs|day|days|week|weeks|wk|wks|month|months|mo|mos|times|level|levels|lvl|game|games|win|wins|point|points|pts|percent|mile|miles|km|inch|inches|bit|gb|mb|fps|hz)\\b)(?! ?(?:years?|yrs?)(?![ -]?old))",
  "WORDAGE": "(?:eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen)",
  "PRONOUN": "(?:she|he|they|xe|ze|it|any)/[a-z]+",
  "NOTSCHOOL": "(?!(?:get|gets|getting|got|so|too|very|am|be|being|feel|feeling|flying|fly|aim|aiming|riding|ride|running|stay|staying|living|sky|mile|knee|super|ultra|really|pretty|always|still|was|is|are|im|i'm|how|this|that|on|a|an|the|of|in|at|to|and|or|junior|jr|senior|from|my|your|our|their)\\b)",
  "BIRTHMARK": "(?:\\b(?:born|b\\.|dob|d\\.o\\.b\\.?|birthday|bday|b-day|birthdate|birth ?date|date of birth)|\u0002)"
 },
 "handle": {
  "strip": "@",
  "separators": "._-",
  "age": {
   "min": 8,
   "max": 17,
   "patterns": {
    "age_then_yo": "(?<![0-9])0*([0-9]{1,2})[._-]*y[._/-]*o(?:ld)?(?![a-z])",
    "age_then_years_old": "(?<![0-9])0*([0-9]{1,2})[._-]*(?:yrs?|years?)[._-]*old(?![a-z])",
    "word_then_age": "(?:^[._-]*|(?<![a-z])(?:my|im|[a-z])[._-]+|(?<![a-z])my|[0-9][._-]*)aged?[._-]*0*([0-9]{1,2})(?![0-9])"
   },
   "not_after": "(?:of|mom|mum|dad|son|daughter|parent|mother|father)[._-]*$",
   "note": "An age-specific token for min to max. not_after: the token is about someone else when the handle reads like mom_of_16yo, so it does not block."
  },
  "words": {
   "pattern": "(?<!th)underage|preteen|jailbait",
   "leet": [
    {
     "0": "o",
     "1": "i",
     "3": "e",
     "4": "a",
     "5": "s",
     "7": "t"
    },
    {
     "0": "o",
     "1": "l",
     "3": "e",
     "4": "a",
     "5": "s",
     "7": "t"
    }
   ]
  },
  "soft_year": {
   "pattern": "(?<![0-9])((?:19|20)[0-9]{2})(?![0-9])",
   "min_age": 6,
   "max_age": 17,
   "note": "a four-digit year that would make the person min_age to max_age today, so under 18. A soft signal: it never blocks alone"
  },
  "soft_years": {
   "pattern": "(?<![0-9])0*([0-9]{1,2})[._-]*(?:years|year|yrs|yr)(?![._-]*old(?![a-z]))(?!s)",
   "min": 8,
   "max": 17,
   "note": "digits then yrs or years with no 'old': 10yrs_exp, 12years_sober. A soft signal like the birth year: it never blocks alone"
  }
 },
 "content": {
  "birth": {
   "min_age": 8,
   "year_only_max_age": 18,
   "two_digit_base": 2000,
   "field_keys": [
    "birthday",
    "birth_date",
    "birthdate",
    "born",
    "dob",
    "date_of_birth"
   ],
   "field_pattern": "(?<![0-9])((?:19|20)[0-9]{2})(?:-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]))?(?![0-9])",
   "age_field_keys": [
    "age"
   ],
   "age_field_pattern": "^([0-9]{1,2})$",
   "age_min": 8,
   "age_max": 17
  },
  "class_year": {
   "max_ahead": 12,
   "strong_ahead": 5,
   "this_year_until_month": 6,
   "two_digit_base": 2000
  },
  "contexts": {
   "occupation": {
    "pattern": "\\b(?:teacher|teachers|teach|teaches|teaching|taught|professor|prof|principal|coach|coaches|coaching|tutor|tutors|tutoring|educator|counselor|counsellor|librarian|instructor|lecturer|faculty|superintendent|alumni|alum|alumnus|alumna|former|formerly|graduated|retired|pta|substitute|paraprofessional|booster)\\b",
    "note": "someone who works with or has left school"
   },
   "family": {
    "pattern": "\\b(?:mom|mum|mommy|mama|momma|mother|dad|daddy|father|papa|parent|parents|grandma|grandpa|grandmother|grandfather|nana|aunt|auntie|uncle|stepmom|stepdad) (?:of|to)\\b|\\b(?:my|our) (?:son|sons|daughter|daughters|kid|kids|child|children|boy|boys|girl|girls|oldest|youngest|eldest|baby|babies|twins|teen|teens|students|class|niece|nephew|grandson|granddaughter|grandkid|grandkids|little one|little ones|little brother|little sister|brother|sister|bro|sis)\\b|\\b(?:proud|boy|girl|soccer|hockey|dance|band|football|baseball|cheer|stay at home|homeschool|homeschooling) (?:mom|mum|mama|dad|parent)\\b|\\b(?:sahm|parent|parenting)\\b|\\b(?:have|has|raising) (?:a|an|[0-9]|two|three|four)\\b",
    "note": "someone writing about a child or relative"
   },
   "object": {
    "pattern": "\\b(?:dog|dogs|cat|cats|pup|puppy|kitten|horse|pony|rescue|whisky|whiskey|scotch|bourbon|rum|wine|cheese|cask|barrel|vintage|car|truck|house|company|business|startup|account|blog|channel|server|tree|marriage|married|sober|clean|veteran|vet|experience)\\b",
    "note": "an age that belongs to a pet or a thing"
   },
   "college": {
    "pattern": "\\b(?:college|university|uni|univ|undergrad|undergraduate|campus|institute|polytechnic|phd|msc|bsc|degree|major|majoring|law school|med school|grad school|community college)\\b",
    "note": "higher education"
   },
   "not_own_birth": {
    "pattern": "\\b(?:company|business|brand|band|studio|label|shop|store|project|channel|account|blog|podcast|est|established|founded|team|club)\\b",
    "note": "a founding year, not a birth year"
   },
   "hs_level": {
    "pattern": "\\b(?:hs|high ?school|high ?schooler|middle ?school|middle ?schooler|junior high|jr\\.? high|{{ORD}} grade|{{ORD}} grader|grade (?:1[0-2]|[1-9])|{{ORDWORD}} grade)\\b",
    "note": "school-level context for a class year"
   },
   "hs_name": {
    "pattern": "\\b{{NOTSCHOOL}}[a-z]+ (?:high|middle)(?: school)?\\b(?= ?'[0-9]{2}| ?[|,~]|$| (?:class|c/o|co|varsity|jv|football|soccer|band|cheer|student|sophomore|freshman|junior|senior)\\b)|\\b(?:at|@|attend|attends|attending|go to|goes to) [a-z' ]{0,20}(?:high|middle)\\b|\\b[a-z]{1,4}hs ?'[0-9]{2}",
    "note": "a school name: the word high or middle next to a name, followed by a class marker or the end of an item"
   },
   "hs_marker": {
    "pattern": "\\b(?:freshman|sophomore|junior|senior|frosh|student|pupil|in (?:[a-z]+ )?{{HS}}|at [a-z' ]{0,30}{{HS}}|attend|attends|attending|goes to|go to|grade|class of|c/o|{{ORD}})\\b",
    "note": "a current-student marker beside high school"
   },
   "hs_past": {
    "pattern": "\\b{{HS}} (?:musical|dxd|of the dead|sweetheart|sweethearts|reunion|diploma|graduate|grad|dropout|drop-out|days|years|friend|friends|buddy|buddies|crush)\\b|\\b(?:since|after|out of|back in|finished|left|post|survived|old|ex|from|during|hated|loved|miss|missed) (?:my |the )?{{HS}}\\b",
    "note": "high school as the past or as a title"
   },
   "grade_past": {
    "pattern": "\\b(?:since|from|back in|until|after|before|was in|were in) (?:the |like )?(?:{{ORD}}|{{ORDWORD}}) grade",
    "note": "a grade named as the past"
   },
   "grade_other": {
    "pattern": "\\bgrade (?:1[0-2]|[1-9]) (?:piano|violin|viola|cello|guitar|flute|clarinet|sax|saxophone|trumpet|drums|voice|singing|singer|music|musician|theory|distinction|merit|pass|listed|steel|bolt|fuel|beef)\\b|\\b(?:abrsm|trinity)\\b",
    "note": "music and other grades"
   },
   "year_other": {
    "pattern": "\\b(?:this|last|next|every|each|per|a|one|fiscal|tax|model|new|leap|gap|the|of|for) (?:year|yr) (?:1[01]|[7-9])\\b",
    "note": "a counted year, not a school year"
   },
   "gcse_other": {
    "pattern": "\\b[0-9]+ gcses?\\b|\\bgcses? (?:tutor|teacher|examiner|marker|tutoring|maths tutor|english tutor)\\b",
    "note": "exam results on a CV, or teaching them"
   },
   "my_age": {
    "pattern": "\\b(?:my|our|of) (?:[a-z]+ )?(?:1[0-7]|[89]) ?-?(?:y|yr|year)",
    "note": "someone else's age"
   },
   "age_prep": {
    "pattern": "\\b(?:at|by|since|from|until|till|before|after|around|about|of|the|any|average|was|when|under|over|your|what|for|reading|mental|drinking|voting) aged? ?:? ?[0-9]",
    "note": "an age in a story or a rule, not the writer's own"
   },
   "minor_other": {
    "pattern": "\\bminor (?:in|league|leagues|issue|issues|key|chord|scale|detail|details|bug|bugs|update|character|characters|arcana|threat|inconvenience)\\b|\\b(?:[a-g]|sharp|flat|no|zero|not a) minor\\b|\\bminor (?:dni|do not|don't|dont|will be|blocked|not allowed)\\b|\\bno minors\\b",
    "note": "a minor subject, key or league, or a notice to minors"
   },
   "under18_notice": {
    "pattern": "\\b(?:no|not|if|anyone|nobody|unless|block|blocking|dni|don't|dont|do not|unfollow)\\b[a-z' ]{0,20}(?:under ?18|u18)|(?:under ?18|u18)[a-z' ]{0,12}(?:dni|do not|don't|dont|block|unfollow|not allowed|get out|leave|bye|will be)|\\bu18 (?:team|squad|coach|national|league|rugby|football|hockey|cup|champion|champions)\\b",
    "note": "a notice to people under 18, or a sports age group"
   },
   "school_other": {
    "pattern": "\\b(?:old|art|law|med|medical|grad|graduate|business|film|music|driving|flight|night|sunday|trade|culinary|dental|nursing|vet|pre|nursery|boarding|home|beauty|cosmetology|bible|dance|language|coding|design|drama|summer) ?-?school\\b|\\bschool (?:of|board|bus|district|psychologist|nurse|counselor|run|pickup|runs|governor|shooting|shootings)\\b",
    "note": "a school that is not a child's school, or a school as a workplace"
   },
   "third_party": {
    "pattern": "\\b(?!(?:age|and|who|that|it|this|account|profile|i|ive|i've|just|finally|recently|officially|only|now|newly)\\b)[a-z]+ (?:is|just turned|turned|turns) (?:now |only |almost |nearly |turning )?(?:1[0-7]|[89])\\b",
    "note": "an age stated about a named other: Rex is 14"
   }
  },
  "rules": [
   {
    "id": "im_age",
    "kind": "age",
    "strength": "strong",
    "fields": [
     "bio",
     "name"
    ],
    "value": "age",
    "min": 8,
    "max": 17,
    "pattern": "\\b(?:i'm|i am)(?: (?:only|just|turning|almost|nearly|currently|like|literally|still|a))* {{AGE}}{{NOTAGE}}"
   },
   {
    "id": "im_age_bare",
    "kind": "age",
    "strength": "strong",
    "fields": [
     "bio"
    ],
    "value": "age",
    "min": 8,
    "max": 17,
    "pattern": "\\bim(?: (?:only|just|turning|almost|nearly|currently|like|literally|still|a))* {{AGE}}{{NOTAGE}}(?!\\. ?[a-z])"
   },
   {
    "id": "im_age_word",
    "kind": "age",
    "strength": "strong",
    "fields": [
     "bio",
     "name"
    ],
    "value": "none",
    "pattern": "\\b(?:i'm|i am|im)(?: (?:only|just|turning|almost|nearly|currently))* {{WORDAGE}}\\b(?! ?(?:times|x|percent|minutes|hours|days|weeks|months|inch|inches|feet|foot)\\b)(?! ?(?:years?|yrs?)(?![ -]?old))"
   },
   {
    "id": "turning",
    "kind": "age",
    "strength": "strong",
    "fields": [
     "bio"
    ],
    "value": "age",
    "min": 9,
    "max": 18,
    "pattern": "\\bturning (1[0-8]|9){{NOTAGE}}",
    "unless": [
     [
      "family",
      "clause"
     ],
     [
      "object",
      "clause"
     ],
     [
      "third_party",
      "clause"
     ]
    ]
   },
   {
    "id": "turned",
    "kind": "age",
    "strength": "strong",
    "fields": [
     "bio"
    ],
    "value": "age",
    "min": 8,
    "max": 17,
    "pattern": "\\b(?:just )?turned {{AGE}}{{NOTAGE}}",
    "unless": [
     [
      "family",
      "clause"
     ],
     [
      "object",
      "clause"
     ],
     [
      "third_party",
      "clause"
     ]
    ]
   },
   {
    "id": "im_minor",
    "kind": "age",
    "strength": "strong",
    "fields": [
     "bio",
     "name"
    ],
    "value": "none",
    "pattern": "\\b(?:i'm|i am|im)(?: still)? (?:a minor(?! league)(?! in )|underage|under ?18|u18)\\b"
   },
   {
    "id": "minor_item",
    "kind": "age",
    "strength": "strong",
    "fields": [
     "bio"
    ],
    "value": "none",
    "pattern": "{{ITEM_L}}minor(?= ?[|,~!]| [/-] |$)",
    "unless": [
     [
      "minor_other",
      "clause"
     ]
    ]
   },
   {
    "id": "age_unit",
    "kind": "age",
    "strength": "strong",
    "fields": [
     "bio",
     "name"
    ],
    "value": "age",
    "min": 8,
    "max": 17,
    "pattern": "(?<![0-9$#.:/-]){{AGE}} ?-?(?:y/o|y\\.o\\.?|yo|yrs?\\.? ?-?old|years? ?-?old|year-old|years of age)(?![a-z])",
    "unless": [
     [
      "my_age",
      "clause"
     ],
     [
      "family",
      "clause"
     ],
     [
      "object",
      "clause"
     ],
     [
      "third_party",
      "clause"
     ]
    ]
   },
   {
    "id": "age_word_unit",
    "kind": "age",
    "strength": "strong",
    "fields": [
     "bio",
     "name"
    ],
    "value": "none",
    "pattern": "\\b{{WORDAGE}} ?-?(?:y/o|y\\.o\\.?|yo|yrs?\\.? ?-?old|years? ?-?old|year-old)(?![a-z])",
    "unless": [
     [
      "my_age",
      "clause"
     ],
     [
      "family",
      "clause"
     ],
     [
      "object",
      "clause"
     ]
    ]
   },
   {
    "id": "age_word",
    "kind": "age",
    "strength": "strong",
    "fields": [
     "bio",
     "name"
    ],
    "value": "age",
    "min": 8,
    "max": 17,
    "pattern": "\\baged?:? ?{{AGE}}(?![0-9])(?! ?(?:\\+|and up|and over|or older|to |- ?[0-9]|months|weeks))(?![.:/][0-9])",
    "unless": [
     [
      "age_prep",
      "clause"
     ],
     [
      "family",
      "clause"
     ],
     [
      "object",
      "clause"
     ],
     [
      "third_party",
      "clause"
     ]
    ]
   },
   {
    "id": "age_first",
    "kind": "age",
    "strength": "strong",
    "fields": [
     "bio"
    ],
    "value": "age",
    "min": 10,
    "max": 17,
    "pattern": "^{{TEEN}}{{SEP_AFTER}}(?! ?[0-9])"
   },
   {
    "id": "age_first_gender",
    "kind": "age",
    "strength": "strong",
    "fields": [
     "bio"
    ],
    "value": "age",
    "min": 10,
    "max": 17,
    "pattern": "^(?:{{TEEN}} ?[fm]|[fm] ?/? ?{{TEEN}})(?:{{SEP_AFTER}}|$)"
   },
   {
    "id": "age_first_and",
    "kind": "age",
    "strength": "strong",
    "fields": [
     "bio"
    ],
    "value": "age",
    "min": 10,
    "max": 17,
    "pattern": "^{{TEEN}} (?:(?:and|&) [a-z]|\\((?:almost|nearly|turning|soon) )"
   },
   {
    "id": "age_item_marker",
    "kind": "age",
    "strength": "strong",
    "fields": [
     "bio"
    ],
    "value": "age",
    "min": 10,
    "max": 17,
    "pattern": "{{ITEM_L}}{{TEEN}}(?: ?[|,~] ?| [/-] | )(?:(?:she|he|they|xe|ze|it|any)/[a-z]|any pronouns\\b|(?:sophomore|freshman|frosh|junior|senior|student)\\b|hs\\b|high ?school|{{ORD}} grade|grade [0-9])"
   },
   {
    "id": "age_after_pronoun",
    "kind": "age",
    "strength": "strong",
    "fields": [
     "bio"
    ],
    "value": "age",
    "min": 8,
    "max": 17,
    "pattern": "\\b{{PRONOUN}}(?: ?[|,~] ?| [/-] | ){{AGE}}(?= ?[|,~]| [/-] |$)"
   },
   {
    "id": "middle_school",
    "kind": "school",
    "strength": "strong",
    "fields": [
     "bio",
     "name"
    ],
    "value": "none",
    "pattern": "\\b(?:middle ?school|middle ?schooler|junior high|jr\\.? high|high ?schooler)\\b",
    "unless": [
     [
      "occupation",
      "text"
     ],
     [
      "family",
      "text"
     ],
     [
      "grade_past",
      "clause"
     ]
    ]
   },
   {
    "id": "high_school_student",
    "kind": "school",
    "strength": "strong",
    "fields": [
     "bio"
    ],
    "value": "none",
    "pattern": "\\b{{HS}}\\b",
    "needs": [
     [
      "hs_marker",
      "clause"
     ]
    ],
    "unless": [
     [
      "occupation",
      "text"
     ],
     [
      "family",
      "text"
     ],
     [
      "hs_past",
      "clause"
     ],
     [
      "college",
      "clause"
     ]
    ]
   },
   {
    "id": "student_at_high",
    "kind": "school",
    "strength": "strong",
    "fields": [
     "bio"
    ],
    "value": "none",
    "pattern": "\\b(?:freshman|sophomore|junior|senior|student|frosh) (?:at|@) [a-z' ]{0,25}\\bhigh\\b",
    "unless": [
     [
      "occupation",
      "text"
     ],
     [
      "family",
      "text"
     ],
     [
      "college",
      "clause"
     ]
    ]
   },
